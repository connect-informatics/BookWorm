{
  "files.eol": "\n",
  "dotnet.defaultSolution": "BookWorm.slnx",
  "typescript.enablePromptUseWorkspaceTsdk": true,
  "dotnet.automaticallyCreateSolutionInWorkspace": false,
  "dotnet.previewSolution-freeWorkspaceMode": true,
  "dotnet.testWindow.useTestingPlatformProtocol": true,
  "sonarlint.connectedMode.project": {
    "connectionId": "connect-informatics",
    "projectKey": "connect-informatics_BookWorm"
  },
  "editor.defaultFormatter": "esbenp.prettier-vscode",
  "[csharp]": {
    "editor.defaultFormatter": "ms-dotnettools.csharp"
  },
  "files.exclude": {
    "**/node_modules": true,
    "**/bin": true,
    "**/obj": true,
    "**/.sonarqube": true
  }
}
